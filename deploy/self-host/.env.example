# Copy to .env next to compose.yaml (`cp .env.example .env`); compose reads it. Every variable has a working default.

# Image to run: `docker compose build` makes it locally under this name; once published, `docker compose pull` fetches it.
# RSVA_IMAGE=ghcr.io/r3cursiva/recursiva
# RSVA_TAG=latest

# Where the app listens on this machine. 127.0.0.1 keeps it to this machine; 0.0.0.0 opens it to the network (then put TLS
# in front and set the three addresses below).
RSVA_BIND=127.0.0.1
RSVA_PORT=3800

# Postgres password. Used only between the two containers; the database port is not published.
DB_PASSWORD=change-me

# Who may create workspaces (comma-separated addresses). `./bootstrap.sh` makes the first one for the address you give it.
RSVA_WORKSPACE_CREATORS=you@example.com

# Sign-in codes. Without a mail provider the code is written to the server log: `docker compose logs app`.
# Leave RSVA_MAIL=log only while the logs are yours alone. To send codes by mail, set a Resend key (https://resend.com)
# and a sender address on a domain you verified there; then RSVA_MAIL may stay as it is.
RSVA_MAIL=log
RESEND_API_KEY=
RSVA_MAIL_FROM=

# Behind a domain (Caddy, nginx, a tunnel): the host name people type, the origin of the page, and the proxy's address
# as the app sees it (docker network gateway for a proxy on this machine: `docker network inspect`). Leave empty for localhost.
RSVA_ALLOWED_HOSTS=
RSVA_ALLOWED_ORIGINS=
RSVA_TRUST_PROXY=

# Mail notifications of changes (needs a mail provider): on or off.
RSVA_NOTIFY=off

LOG_LEVEL=info
