# Copy to .env at the repository root (git ignores it); `pnpm dev` and `pnpm --filter @rsva/server start` read it.
# Sign-in codes by mail through Resend: a key that may send from RSVA_MAIL_FROM's domain. Without it, dev prints codes
# to the server log. RSVA_MAIL_FROM is a bare address: every mail comes from "recursiva" (SENDER_NAME, auth/mail.ts).
RESEND_API_KEY=
RSVA_MAIL_FROM=plan@rsva.dev

# Who may create workspaces: comma-separated addresses, any case. Unset or empty, nobody may (POST /api/v1/workspaces
# answers 403); members and invited people still sign in. `pnpm dev` sets owner@sample.test (the fixtures' owner) unless
# the shell has its own value (an empty one included): a value here is overridden by the dev script.
RSVA_WORKSPACE_CREATORS=you@example.com
